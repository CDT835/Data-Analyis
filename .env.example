# Khóa bí mật dùng chung với plugin WordPress (>= 32 ký tự). Phải GIỐNG HỆT bên Cài đặt plugin.
AIAR_SHARED_SECRET=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu
# Khóa CŨ, chỉ đặt trong lúc xoay khóa (xem README-GIAI-DOAN-7.md, mục 0.20.0). Xong thì xóa dòng này.
# AIAR_SHARED_SECRET_PREVIOUS=
# Giới hạn số yêu cầu hợp lệ mỗi phút và số lần ký sai mỗi IP mỗi phút
AIAR_RATE_PER_MIN=120
AIAR_AUTH_FAIL_PER_MIN=20
# Cho phép lệch đồng hồ giữa WordPress và Python (giây)
AIAR_MAX_SKEW_SECONDS=300
# Bật trang /docs (Swagger) khi chạy local để minh họa đồ án
AIAR_ENABLE_DOCS=1
# Giới hạn tài nguyên (tùy chọn). Gói miễn phí chỉ có 512 MB RAM.
AIAR_MAX_FILE_MB=10
AIAR_MAX_ROWS=100000
AIAR_MAX_COLS=200

# Che email, số điện thoại, mã số dài, tên công ty trong nội dung gửi sang Groq (1 = bật, 0 = tắt)
AIAR_AI_MASK=1
